{
  "name": "Insight",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Which analysis produced this insight.",
      "enum": [
        "daily_digest",
        "customer_behaviour",
        "demand_forecast",
        "menu_engineering",
        "workforce",
        "clv",
        "busy_prediction"
      ]
    },
    "period": {
      "type": "string",
      "description": "Window covered, e.g. '2026-06-28', '2026-W26', '2026-06'."
    },
    "headline": {
      "type": "string",
      "description": "One-line summary for the dashboard strip."
    },
    "payload_json": {
      "type": "object",
      "description": "Structured analysis output (Claude tool result)."
    },
    "recommended_action": {
      "type": "string",
      "description": "Single suggested action (a proposal, not auto-applied)."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "basis": {
      "type": "string",
      "description": "What the insight is grounded in, e.g. 'last 6 same-weekdays, 142 orders'."
    },
    "acted_on": {
      "type": "boolean",
      "default": false
    },
    "model": {
      "type": "string",
      "description": "Model used, for auditing."
    }
  },
  "required": [
    "type",
    "period"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
